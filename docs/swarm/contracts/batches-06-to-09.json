{
  "schema": "swarm-batch-contract/v1",
  "org": "english-coach-swarm",
  "spec_ref": "docs/swarm/ORG-SPEC.md",
  "governance": {
    "goal_keeper": "human (非委托裁决：目标锚 / License / 术语首选译法 / 定义变更)",
    "l1_machine_gate": {
      "cmd": "python3 tools/verify_docs.py",
      "blocks": true,
      "note": "FAIL 存在时本批产物不得交付"
    },
    "l2_discriminator": {
      "role": "verifier-agent",
      "isolation": "fresh 会话，不参与任何生成",
      "checklist": "逐条对照能力卡的『完成标准』，不看篇幅看标准"
    },
    "l3_escape_monitor": {
      "metric": "逃逸距离 = 产生批次 → 被 L1/L2 抓出的批次",
      "action": "逃逸距离连续变长 → 判定门降级为人工抽检"
    },
    "concurrency_limit": 4,
    "recursion_depth_max": 2,
    "file_ownership": "硬隔离：域 agent 只能写契约第 4 节列出的文件；跨文档修正走返回清单，由 orchestrator 串行应用"
  },
  "memory_partitions": {
    "core": { "budget_tokens": 4000, "eviction": "none", "content": "目标 + 不可变约束" },
    "local": { "budget_tokens": 8000, "eviction": "batch_end", "content": "本批契约 + 前序批次结论摘要（带路径，不带全文）" },
    "per_child_queue": { "budget_tokens": 2000, "eviction": "oldest_first", "content": "域 agent 待处理队列" }
  },
  "batches": [
    {
      "id": "batch-09-dataflow-systemflow",
      "agent": "domain-agent-a",
      "goal": "产出数据流图与系统流程两张 RML 模型，收掉批次 4/5 遗留的三个挂账",
      "cards": [
        "/Users/mac/Library/Application Support/com.ai-toolbox/skills/visual-models-requirements-skill/references/capabilities/data-flow-diagram.md",
        "/Users/mac/Library/Application Support/com.ai-toolbox/skills/visual-models-requirements-skill/references/capabilities/system-flow.md"
      ],
      "inputs": [
        "docs/requirements/02-business-data-diagram.md",
        "docs/requirements/03-data-dictionary.md",
        "docs/requirements/04-state-table.md",
        "docs/requirements/07-decision-tree.md",
        "docs/requirements/08-ecosystem-map.md",
        "docs/requirements/09-system-interface-table.md"
      ],
      "owns": ["docs/requirements/10-data-flow-diagram.md", "docs/requirements/11-system-flow.md"],
      "must_resolve": [
        "TTS 失效时 B0 档的降级链（生态图 §4.2 遗留）",
        "chunk-ledger 合账后是否一律重算调度，不得静默丢一方（接口表 §八.1 遗留）",
        "journal 派生重算链：session-log / 下一步指针 / 统计各自的触发与失败补偿"
      ],
      "acceptance": [
        "每条数据流标注来源、终点、载体（文件/内存/网络）",
        "每个自动处理步骤有异常补偿路径",
        "能力卡 E 段完成标准逐条自检并写入文末"
      ]
    },
    {
      "id": "batch-08-ui-dar",
      "agent": "domain-agent-b",
      "goal": "产出 UI Flow 与 DAR 两张 RML 模型，为壳层实现提供导航清单与屏幕状态穷举",
      "cards": [
        "/Users/mac/Library/Application Support/com.ai-toolbox/skills/visual-models-requirements-skill/references/capabilities/user-interface-flow.md",
        "/Users/mac/Library/Application Support/com.ai-toolbox/skills/visual-models-requirements-skill/references/capabilities/display-action-response.md"
      ],
      "inputs": [
        "docs/requirements/01-feature-tree.md",
        "docs/requirements/04-state-table.md",
        "docs/requirements/05-state-diagram.md",
        "docs/requirements/07-decision-tree.md",
        "docs/requirements/08-ecosystem-map.md"
      ],
      "owns": ["docs/requirements/12-user-interface-flow.md", "docs/requirements/13-display-action-response.md"],
      "must_resolve": [
        "同步四态（含新增的『同步失败』）在界面上的呈现差异——决策树 §四 已给出四个分支，需逐个定义界面行为",
        "判定级别 T0/T1/T2 的降级标记如何可见（A9 对策：降级须让学习者先看见）",
        "iOS 单列流与 macOS 三栏各自独立的屏幕清单，不做响应式拉伸（死法 A8）"
      ],
      "acceptance": [
        "UI Flow 无死端无孤岛",
        "屏幕数按 7±2 分层，超限则分设备分型出图",
        "DAR 每条响应可回答：触发什么、显示什么、下一步能去哪"
      ]
    },
    {
      "id": "batch-06-rp-rmm",
      "agent": "domain-agent-c",
      "goal": "产出角色权限矩阵与需求映射矩阵，把『单写者』约束与需求双向追溯固化",
      "cards": [
        "/Users/mac/Library/Application Support/com.ai-toolbox/skills/visual-models-requirements-skill/references/capabilities/roles-permissions-matrix.md",
        "/Users/mac/Library/Application Support/com.ai-toolbox/skills/visual-models-requirements-skill/references/capabilities/requirements-mapping-matrix.md"
      ],
      "inputs": [
        "docs/requirements/00-business-objectives.md",
        "docs/requirements/01-feature-tree.md",
        "docs/requirements/02-business-data-diagram.md",
        "docs/requirements/03-data-dictionary.md",
        "docs/requirements/04-state-table.md"
      ],
      "owns": ["docs/requirements/14-roles-permissions-matrix.md", "docs/requirements/15-requirements-mapping-matrix.md"],
      "must_resolve": [
        "单写者约束的完整落表：教练官唯一写 learner-state、记忆官唯一写 chunk-ledger 调度栏、选材官唯一写 corpus、判读官唯一写 error-book",
        "RMM 检查『有没有需求没有流程支撑 / 有没有流程没需求』——注意：处理流程与用例在另一批次，RMM 须留出占位并标为待回填",
        "执行特性树 E5 的第三、第四个交叉校验源：哪些特性需求过少"
      ],
      "acceptance": [
        "R&P 行列完整，每个角色对每个系统操作有明确的是/否",
        "学习者以 goal-keeper 兼任管理人员——须显式声明口径适配",
        "RMM 每个需求至少映射到一个特性，且反向追溯到 BOM 业务目标"
      ]
    },
    {
      "id": "batch-07-processflow-usecase",
      "agent": "domain-agent-d",
      "goal": "产出处理流程与用例两张 RML 模型，为验收测试提供用例规格",
      "cards": [
        "/Users/mac/Library/Application Support/com.ai-toolbox/skills/visual-models-requirements-skill/references/capabilities/process-flow.md",
        "/Users/mac/Library/Application Support/com.ai-toolbox/skills/visual-models-requirements-skill/references/capabilities/use-case.md"
      ],
      "inputs": [
        "docs/requirements/00-business-objectives.md",
        "docs/requirements/02-business-data-diagram.md",
        "docs/requirements/04-state-table.md",
        "docs/requirements/07-decision-tree.md",
        "docs/org-design.md"
      ],
      "owns": ["docs/requirements/16-process-flow.md", "docs/requirements/17-use-case.md"],
      "must_resolve": [
        "唤起协议六条（继续/2分钟/5分钟/15分钟/只要听/太难了/停）逐条展开为完整用例，含前提、主路径、替代路径、异常",
        "跨角色交接泳道：学习者 / 教练官 / 判读官 / 记忆官",
        "B0 档的 0 轮会话在用例中的表现——这是悬空会话（DD104）的业务解释"
      ],
      "acceptance": [
        "每个用例含前提/主路径/替代路径/异常四段",
        "用例步数按 7±2 拆分，超限则拆为多个用例",
        "用例直接支撑 app-design 的 AC 十一条可测性"
      ]
    }
  ],
  "return_contract": {
    "required_fields": [
      "products: [{path, 能力卡已读声明}]",
      "cross_doc_fixes: [{file, 变更内容, 理由, 证据}]",
      "open_questions: [{事项, 为何我不能替你决定}]",
      "self_check: {卡内完成标准逐条: 达标/未达标 + 证据}",
      "l1_result: 校验器输出摘要"
    ],
    "forbid": "域 agent 直接修改非 owns 文件——违反即视为逃逸"
  }
}
